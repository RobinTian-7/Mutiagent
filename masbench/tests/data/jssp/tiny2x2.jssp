# Tiny 2 jobs x 2 machines instance for offline machinery tests.
#   job0: (machine 0, 2) -> (machine 1, 2)
#   job1: (machine 1, 3) -> (machine 0, 2)
# Optimum derivation: machine 1 must process job1 op0 (3) + job0 op1 (2) = 5
# total, so makespan >= 5. Achieved by:
#   M0: job0 op0 [0,2), job1 op1 [3,5)
#   M1: job1 op0 [0,3), job0 op1 [3,5)
# (job0 op1 waits for M1 until t=3; job1 op1 waits for job1 op0 until t=3.)
# Hence the optimum makespan is exactly 5.
# ub: 5
2 2
0 2 1 2
1 3 0 2
